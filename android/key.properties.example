# Android Keystore Configuration Template
# -------------------------------------------------------------
# 1. Copy this file to 'android/key.properties':
#    cp android/key.properties.example android/key.properties
# 2. Fill in your actual keystore credentials below.
# 3. Place your keystore file (.jks or .keystore) in 'android/app/'
#    or specify an absolute/relative path.
# -------------------------------------------------------------
# IMPORTANT: NEVER commit 'key.properties' or your *.jks / *.keystore
# file into version control!
# -------------------------------------------------------------

storePassword=your_store_password_here
keyPassword=your_key_password_here
keyAlias=your_key_alias_here
storeFile=upload-keystore.jks
